# Canon needs no secrets to ingest, audit or serve locally. Copy to .env only for the optional parts below.
# Never commit a real value.

# Where the export is read from and where outputs go (the Docker image sets /data and /out).
CANON_DATA_DIR=data/synthetic
CANON_OUT_DIR=out

# Optional: stamp run.json with the code version you deployed (e.g. the git commit).
# CANON_GIT_SHA=

# Optional: read-only CRM pull (`canon pull`).
# HUBSPOT_TOKEN=
# SALESFORCE_TOKEN=
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com

# Optional: before/after eval with a hosted model (sends questions and retrieved text off-network: needs the
# client's written consent). Prefer a client-hosted model via --model openai-compatible --base-url.
# ANTHROPIC_API_KEY=
# BASETEN_API_KEY=

# Optional: Chromium for the browser test (defaults to /opt/pw-browsers/chromium, else Playwright's own).
# CANON_CHROMIUM=
