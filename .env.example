# Canon has no required secrets for milestones 1-2. Copy to .env if needed.
# Path to the dataset root (defaults to data/synthetic).
CANON_DATA_DIR=data/synthetic
# Output directory for resolved artifacts (golden records, SQLite store, reports).
CANON_OUT_DIR=out
# Reserved for the eval harness (M5). Never commit a real key.
# ANTHROPIC_API_KEY=
